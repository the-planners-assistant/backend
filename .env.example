# .env - Example Environment Variables
# Make sure this file is in your .gitignore if it contains secrets

PROJECT_NAME="The Planner's Assistant API (Dev)"
REDIS_URL=redis://localhost:6379/0
# Default Redis URL for local development

# Reverse geocoding API Key
GOOGLE_GEOCODE_API_KEY="your_google_geocode_api_key"
MAPS_STATIC_API_KEY="your_maps_static_api_key"

# Gemini API Key
GEMINI_API_KEY="your_gemini_api_key"

# Add other environment-specific settings
# SOME_API_KEY="your_development_api_key"
# .env file

# PostgreSQL Connection Details
PGHOST=localhost
PGPORT=5432
PGDATABASE=planning_data
PGUSER=planner
PGPASSWORD=a_strong_password

# Optional: Target Schema (defaults to public if not set)
PGSCHEMA=public

# Optional: ogr2ogr Settings
TARGET_SRS=4326 # Or EPSG:27700 for British National Grid
GEOMETRY_NAME=geom
OVERWRITE_TABLE=True # Set to False to append instead of overwriting